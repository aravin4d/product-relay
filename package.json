{
  "name": "product-relay",
  "version": "0.5.0-phase2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs && npm test",
    "check:static": "node scripts/check.mjs && node --experimental-vm-modules scripts/module-graph.mjs",
    "package:backend": "node scripts/package-backend.mjs",
    "prepare:parsers": "node scripts/prepare-parsers.mjs",
    "predev": "npm run prepare:parsers",
    "build": "node scripts/build.mjs",
    "evaluate:retrieval": "node scripts/evaluate-retrieval.mjs",
    "evaluate:providers": "node scripts/evaluate-providers.mjs"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
