# Backend container only. Replace placeholders in an ignored secrets file.
RELAY_ALLOWED_ORIGINS=https://YOUR_GITHUB_NAME.github.io,http://127.0.0.1:4173
RELAY_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_OCR_MODEL=
OPENAI_TRANSCRIBE_MODEL=
RELAY_WORKER_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RELAY_CONNECTORS_JSON={"projects":{}}
# The self-host main router delegates verified Auth to Relay's functions.
VERIFY_JWT=false
# Supabase runtime injects URL/public/secret keys. Do not expose the secret key.

# Optional credential-vault, consent applications and delivery destinations.
RELAY_CREDENTIAL_KEY=
RELAY_OAUTH_JSON={"providers":{},"returnUrls":[]}
RELAY_DELIVERY_JSON={"destinations":{}}
OPENAI_DIARIZE_MODEL=
# Operator host only; never frontend or public repository.
RELAY_SERVICE_URL=
RELAY_SERVICE_PUBLIC_KEY=
RELAY_SERVICE_SECRET_KEY=
RELAY_DATABASE_URL=
RELAY_BACKUP_KEY=
RELAY_BACKUP_DIRECTORY=/backups
RELAY_RESTORE_DATABASE_URL=
RELAY_RESTORE_SERVICE_URL=
RELAY_RESTORE_SERVICE_SECRET_KEY=
